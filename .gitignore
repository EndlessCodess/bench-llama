# Python
__pycache__/
*.pyc
*.pyo

# Raw LongBench-v2 dataset (444 MiB; re-downloadable, SHA-256 documented in README)
data/longbench-v2/

# Processed prompt text (regenerated deterministically by prepare_dataset.py);
# keep metadata.jsonl / run-manifest.json / source-pool.json / preparation.json
data/processed/*/prompts/
data/processed/*/tokenizer-server.log

# Keep the benchmark prompt pool required by the checked-in run manifest.
!data/processed/qwen3.5-9b/prompts/
!data/processed/qwen3.5-9b/prompts/**

# Raw llama-cli result logs (regenerated by bench_test.py / run_suite.py;
# includes an old mock result that is not a formal benchmark)
results/

# OS junk
.DS_Store

# Build artifacts
build/

# Obsolete run-version archives & old manifest snapshots (kept locally only)
data/processed/qwen3.5-9b-5x10-archive/
data/processed/qwen3.5-9b/run-manifest-v*-*.json

# Suite run logs
rounds*-run.log
